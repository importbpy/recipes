# Application Configuration
APP_ENV=prod
APP_SECRET=efdab0e6fd66a1219859aee8d6103167
ENABLE_REGISTRATIONS=true
SENTRY_DSN=

# Web Server Configuration
HTTP_PORT=8080

# Database Configuration
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=recipes
MYSQL_USER=recipes
MYSQL_PASSWORD=password
MYSQL_PORT=127.0.0.1:4306

# Backup Configuration
# Daily backup at 02:00 UTC (format: minute hour day month day-of-week)
# Used by both the db-backup (databack/mysql-backup) and images-backup services
BACKUP_CRON_SCHEDULE='0 2 * * *'
# Number of days to keep backup archives on droplet
BACKUP_RETENTION_DAYS=7
# Whether to run an images backup immediately on container startup (true/false)
# Note: the db-backup service runs on its cron schedule only, with no immediate run on start
BACKUP_ON_START=false

# Development Tools (optional)
ADMINER_PORT=127.0.0.1:9090
